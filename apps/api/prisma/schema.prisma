// FlowOps PostgreSQL schema — aligned with docs/DATABASE_DESIGN.md
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  admin
  devops
  developer
  release_manager
  viewer
}

enum DeploymentStatus {
  queued
  building
  testing
  waiting_for_approval
  deploying
  health_check
  success
  failed
  rollback_required
  rolling_back
  rolled_back
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired
}

enum IncidentSeverity {
  sev1
  sev2
  sev3
  sev4
}

enum IncidentStatus {
  open
  investigating
  mitigated
  resolved
}

enum HealthProbeType {
  api
  db
  redis
  queue
  external
}

enum HealthProbeStatus {
  healthy
  degraded
  unhealthy
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members      OrganizationMember[]
  teams        Team[]
  services     Service[]
  environments Environment[]
  deployments  Deployment[]
  incidents    Incident[]
  auditLogs    AuditLog[]
  notifications Notification[]
  healthSnapshots ServiceHealthSnapshot[]
  simulationSettings SimulationSettings?

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships       OrganizationMember[]
  teamMemberships   TeamMember[]
  refreshTokens     RefreshToken[]
  triggeredDeploys  Deployment[]         @relation("DeploymentTriggeredBy")
  approvalsDecided  Approval[]           @relation("ApprovalDecidedBy")
  assignedIncidents Incident[]           @relation("IncidentAssignee")
  incidentEvents    IncidentEvent[]      @relation("IncidentEventActor")
  rollbacks         Rollback[]           @relation("RollbackTriggeredBy")
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@map("users")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
  @@map("organization_members")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  slug           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  services     Service[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String?  @map("team_id") @db.Uuid
  name           String
  slug           String
  description    String?
  repositoryUrl  String?  @map("repository_url")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  deployments  Deployment[]
  incidents    Incident[]
  healthSnapshots ServiceHealthSnapshot[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@index([teamId])
  @@map("services")
}

model Environment {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  name             String
  slug             String
  requiresApproval Boolean  @default(false) @map("requires_approval")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  healthCheckConfig HealthCheckConfig?
  deployments     Deployment[]
  incidents       Incident[]
  healthSnapshots ServiceHealthSnapshot[]

  @@unique([organizationId, slug])
  @@index([organizationId, sortOrder])
  @@map("environments")
}

model HealthCheckConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  environmentId         String   @unique @map("environment_id") @db.Uuid
  endpointPath          String   @default("/health") @map("endpoint_path")
  timeoutMs             Int      @default(5000) @map("timeout_ms")
  successThreshold      Int      @default(1) @map("success_threshold")
  failureThreshold      Int      @default(3) @map("failure_threshold")
  latencyThresholdMs    Int      @default(500) @map("latency_threshold_ms")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@map("health_check_configs")
}

model ServiceHealthSnapshot {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  serviceId            String            @map("service_id") @db.Uuid
  environmentId        String            @map("environment_id") @db.Uuid
  overallStatus        HealthProbeStatus @map("overall_status")
  uptimePercent        Float             @map("uptime_percent")
  avgLatencyMs         Int               @map("avg_latency_ms")
  consecutiveFailures  Int               @default(0) @map("consecutive_failures")
  checkedAt            DateTime          @default(now()) @map("checked_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  environment  Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  probes       HealthProbeResult[]

  @@unique([serviceId, environmentId])
  @@index([organizationId, overallStatus])
  @@map("service_health_snapshots")
}

model HealthProbeResult {
  id         String            @id @default(uuid()) @db.Uuid
  snapshotId String            @map("snapshot_id") @db.Uuid
  probeType  HealthProbeType   @map("probe_type")
  status     HealthProbeStatus
  latencyMs  Int               @map("latency_ms")
  message    String?
  checkedAt  DateTime          @default(now()) @map("checked_at") @db.Timestamptz(6)

  snapshot ServiceHealthSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, probeType])
  @@map("health_probe_results")
}

model Deployment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  serviceId      String           @map("service_id") @db.Uuid
  environmentId  String           @map("environment_id") @db.Uuid
  triggeredById  String           @map("triggered_by") @db.Uuid
  version        String
  status         DeploymentStatus @default(queued)
  failureReason  String?          @map("failure_reason")
  commitSha      String?          @map("commit_sha")
  startedAt      DateTime?        @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?        @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  environment  Environment       @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  triggeredBy  User              @relation("DeploymentTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)
  events       DeploymentEvent[]
  approval     Approval?
  rollback     Rollback?
  incident     Incident?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([serviceId, createdAt(sort: Desc)])
  @@index([environmentId, createdAt(sort: Desc)])
  @@index([triggeredById, createdAt(sort: Desc)])
  @@map("deployments")
}

model DeploymentEvent {
  id           String            @id @default(uuid()) @db.Uuid
  deploymentId String            @map("deployment_id") @db.Uuid
  fromStatus   DeploymentStatus? @map("from_status")
  toStatus     DeploymentStatus  @map("to_status")
  message      String?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, createdAt])
  @@map("deployment_events")
}

model Approval {
  id           String         @id @default(uuid()) @db.Uuid
  deploymentId String         @unique @map("deployment_id") @db.Uuid
  status       ApprovalStatus @default(pending)
  decidedById  String?        @map("decided_by") @db.Uuid
  comment      String?
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(6)
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  decidedBy  User?      @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@map("approvals")
}

model Rollback {
  id           String    @id @default(uuid()) @db.Uuid
  deploymentId String    @unique @map("deployment_id") @db.Uuid
  targetVersion String?  @map("target_version")
  triggeredById String   @map("triggered_by") @db.Uuid
  status       String
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  deployment  Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  triggeredBy User       @relation("RollbackTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)

  @@map("rollbacks")
}

model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  deploymentId   String?          @unique @map("deployment_id") @db.Uuid
  serviceId      String           @map("service_id") @db.Uuid
  environmentId  String           @map("environment_id") @db.Uuid
  title          String
  description    String?
  severity       IncidentSeverity
  status         IncidentStatus   @default(open)
  source         String           @default("manual")
  assigneeId     String?          @map("assignee_id") @db.Uuid
  openedAt       DateTime         @default(now()) @map("opened_at") @db.Timestamptz(6)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deployment   Deployment?     @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  service      Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  environment  Environment     @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  assignee     User?           @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events       IncidentEvent[]

  @@index([organizationId, status, openedAt(sort: Desc)])
  @@index([organizationId, severity])
  @@index([serviceId, openedAt(sort: Desc)])
  @@index([organizationId, source])
  @@map("incidents")
}

model IncidentEvent {
  id         String          @id @default(uuid()) @db.Uuid
  incidentId String          @map("incident_id") @db.Uuid
  fromStatus IncidentStatus? @map("from_status")
  toStatus   IncidentStatus  @map("to_status")
  message    String?
  actorId    String?         @map("actor_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation("IncidentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_events")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  payload        Json
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model SimulationSettings {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  simulationMode  Boolean  @default(true) @map("simulation_mode")
  buildFailRate   Float    @default(0) @map("build_fail_rate")
  deployFailRate  Float    @default(0) @map("deploy_fail_rate")
  healthFailRate  Float    @default(0) @map("health_fail_rate")
  stageDelayMs    Int      @default(400) @map("stage_delay_ms")
  deterministic   Boolean  @default(false)
  activeEffects   Json     @default("[]") @map("active_effects")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("simulation_settings")
}
