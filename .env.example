# Optional overrides for docker compose (copy to .env — gitignored)
# JWT secrets must be ≥ 32 characters.

NODE_ENV=production
JWT_ACCESS_SECRET=compose-dev-access-secret-change-me
JWT_REFRESH_SECRET=compose-dev-refresh-secret-change-me
CORS_ORIGIN=http://127.0.0.1:43125,http://localhost:43125

# Optional simulation knobs (also settable in the UI for admins)
# SIM_STAGE_DELAY_MS=400
# SIM_BUILD_FAIL_RATE=0
# SIM_DEPLOY_FAIL_RATE=0
# SIM_HEALTH_FAIL_RATE=0
# APPROVAL_TTL_HOURS=24
